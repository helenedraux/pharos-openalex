{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.local/schemas/pharos-review-guide-v2.schema.json",
  "title": "Pharos deterministic purpose-based review guide",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "purpose", "answers", "report", "introduction", "items", "interoperability", "allowed_statuses", "limitations"],
  "properties": {
    "schema_version": {"const": "pharos-review-guide-v2"},
    "generator": {"const": "deterministic"},
    "purpose": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}}, "additionalProperties": false},
    "answers": {"type": "object", "additionalProperties": {"type": "string"}},
    "report": {"type": "object", "required": ["type", "identity_id", "identity_name", "retrieved_at", "implementation_version", "period"], "properties": {"type": {"enum": ["institution", "researcher", "source", "funder", "publisher"]}, "identity_id": {"type": ["string", "null"]}, "identity_name": {"type": ["string", "null"]}, "retrieved_at": {"type": ["string", "null"]}, "implementation_version": {"type": ["string", "integer", "null"]}, "period": {"type": ["object", "null"]}}, "additionalProperties": false},
    "introduction": {"type": "string"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "guidance", "action", "record", "cannot_decide", "destination", "evidence_refs", "priority", "dimension", "measurement_definition", "observed", "requirement", "materiality"], "properties": {
      "id": {"type": "string"}, "title": {"type": "string"}, "guidance": {"type": "string"}, "action": {"type": "string"}, "record": {"type": "string"}, "cannot_decide": {"type": "string"}, "destination": {"type": "string"}, "dimension": {"type": "string"},
      "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "priority": {"type": "integer", "minimum": 1, "maximum": 3},
      "measurement_definition": {"type": "object", "required": ["id", "label", "formula", "denominator_note", "unit", "scope", "retrieved_at", "implementation_version"], "additionalProperties": true},
      "observed": {"type": ["object", "null"]}, "observation": {"type": ["object", "null"]},
      "requirement": {"type": "object", "required": ["kind", "default", "current", "numeric_default", "numeric_current", "unit", "is_override", "status_ceiling"], "additionalProperties": true},
      "materiality": {"type": "object", "required": ["default", "current", "is_override"], "additionalProperties": false, "properties": {"default": {"enum": ["low", "moderate", "high"]}, "current": {"enum": ["low", "moderate", "high"]}, "is_override": {"type": "boolean"}}}
    }}},
    "interoperability": {"type": "array", "items": {"type": "object", "required": ["id", "label", "test_type", "status", "detail"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "test_type": {"enum": ["automatic", "destination_specific"]}, "status": {"type": "string"}, "detail": {"type": "string"}}}},
    "allowed_statuses": {"type": "array", "items": {"enum": ["not_checked", "meets_configured_requirement", "validation_needed", "does_not_meet_configured_requirement", "not_measured", "not_applicable"]}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
