{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.local/schemas/pharos-readiness-matrix-v1.schema.json",
  "title": "Pharos multi-use readiness comparison",
  "type": "object",
  "required": ["schema_version", "created_at", "report", "uses", "limitations"],
  "properties": {
    "schema_version": {"const": "pharos-readiness-matrix-v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "report": {"type": "object"},
    "uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["purpose", "readiness", "items"],
        "properties": {
          "purpose": {"type": "object"},
          "answers": {"type": "object"},
          "readiness": {"type": "object"},
          "items": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
